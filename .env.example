# Copy to .env and fill in your values

# LLM
GEMINI_API_KEY=your_gemini_api_key_here

# Web Search (get free key at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://insightforge:insightforge@localhost:5432/insightforge

# Redis (Celery broker + job state)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible local storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=insightforge

# Upload directory (temp storage before processing)
UPLOAD_DIR=/tmp/insightforge_uploads
